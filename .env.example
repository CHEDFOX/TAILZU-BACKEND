# =====================================================================
# Tulmi — environment variables (canonical template)
# Copy this file to `tulmi/.env` and fill in real values.
# NEVER commit the real .env. Secrets live ONLY in env vars.
# =====================================================================

# --- Speech-to-Text provider ---
# "auto"  — RECOMMENDED once SARVAM_API_KEY is set. Runs the Indic specialist
#           (Sarvam) and the global generalist (Groq/OpenAI Whisper) at the
#           SAME TIME and keeps the better transcript: Sarvam when the speech
#           is Indic or code-mixed (Hinglish), Whisper for the rest of the
#           world. This is how the backend identifies the language without
#           ever asking the user — you can't route by language before you know
#           it. Two STT calls per dictation; latency is the slower of the two,
#           not the sum.
# "groq"    (default) Whisper — fast, cheap, returns per-segment confidence we
#           use to drop hallucinated segments.
# "openai"  gpt-4o-transcribe — strong ~100-language coverage, no confidence signal.
# "sarvam"  India-first: Sarvam for everything, Whisper only if a call fails.
STT_PROVIDER=groq

# Groq STT (required when STT_PROVIDER=groq — the default). Fast + cheap Whisper.
# Also the fallback leg for "auto" and "sarvam", so keep it set.
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Sarvam (Saarika) — required when STT_PROVIDER=sarvam or auto. Purpose-built
# for Indian languages AND code-mixed speech; called in auto-detect mode
# (language_code=unknown) so it identifies the language itself.
# Get a key: https://dashboard.sarvam.ai
SARVAM_API_KEY=
# saaras:v3 is Sarvam's current model (saarika:v1/v2/flash are deprecated,
# saarika:v2.5 is legacy). v3 also takes a mode.
SARVAM_STT_MODEL=saaras:v3
# What v3 does with the audio. ALWAYS set this: v3 can translate, and an unset
# mode risks Marathi speech coming back as English — which reads exactly like
# "dictation isn't catching my language".
#   transcribe (default) — same language the user spoke
#   codemix              — tuned for Hindi/English mixed speech; worth A/B-ing
#   translit             — native speech returned in Latin script
SARVAM_STT_MODE=transcribe
# Sarvam's STREAMING endpoint (live dictation). Verify against their current
# docs before switching STT_LIVE_PROVIDER to sarvam.
SARVAM_WS_URL=wss://api.sarvam.ai/speech-to-text/ws

# Which engine backs LIVE dictation (/v1/transcribe-stream): "deepgram" or
# "sarvam". SERVER-side — the phone's wire protocol is identical either way, so
# switching is a config change here, never an app update. Pick "sarvam" for
# Indian-language live dictation (Deepgram's weakest area).
STT_LIVE_PROVIDER=deepgram

# Run BOTH live engines on the same audio: the one named above streams to the
# user, the other listens silently, and their transcripts are reconciled at
# stop (the same fusion the one-shot path does). Each engine is strong where
# the other is weak — Deepgram on English/European, Sarvam on Indic and
# code-mixed — so the committed text can beat either alone. Costs two live
# STT streams for the same audio.
STT_LIVE_DUAL=false

# Add Deepgram's pre-recorded API as a THIRD candidate in STT_PROVIDER=auto.
# Costs a third call; no extra latency (the legs run in parallel). Off by
# default — turn on to A/B whether a third opinion is worth it.
STT_AUTO_INCLUDE_DEEPGRAM=false

# OpenAI — OPTIONAL. The app's text-to-speech uses the phone's built-in voice
# (no key needed). A key is only required if you (a) enable the server-side
# voice-preview endpoints (/v1/speak, /v1/voice/preview), or (b) set
# STT_PROVIDER=openai. Leave blank otherwise. Get a key:
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# gpt-4o-transcribe (best), gpt-4o-mini-transcribe (cheaper), or whisper-1 (legacy).
OPENAI_STT_MODEL=gpt-4o-transcribe

# Deepgram (live dictation only — the WS /v1/transcribe-stream route).
# The one-shot REST /v1/transcribe-clean uses STT_PROVIDER above instead.
# Get a key: https://console.deepgram.com/. Leave blank to disable live mode;
# the app's REST fallback still works.
DEEPGRAM_API_KEY=

# --- OpenRouter (cleanup LLM) ---
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default cleanup model. Swap this ONE line to change models — no code edits.
# Default: fast + cheap + strong multilingual.
CLEANUP_MODEL=openai/gpt-5.4-mini

# --- Text-to-speech (voice output; uses OPENAI_API_KEY) ---
# Used when the app speaks back (e.g. the screen bubble reading content aloud).
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Voice: alloy, ash, coral, echo, fable, nova, onyx, sage, shimmer, ...
TTS_VOICE=alloy
# Output: mp3 (default), opus, aac, flac, wav, pcm
TTS_FORMAT=mp3

# Headers OpenRouter uses for attribution/ranking. Override for production so
# the OpenRouter dashboard shows YOUR real app, not the placeholder.
OPENROUTER_APP_URL=https://tailzu.space
OPENROUTER_APP_NAME=Tulmi

# Prompt versions loaded from shared/prompts/. Override only when shipping
# a new variant (a/b testing) or rolling back; the code defaults are v3/v2
# (tone dial + per-app overrides + watermark). These lines previously pinned
# the OLD v2/v1, silently rolling deploys back — keep them at the defaults.
CLEANUP_PROMPT_VERSION=v3
REPLY_PROMPT_VERSION=v2

# --- Supabase (auth + usage metering) ---
# Project settings → API. URL is public; the SERVICE ROLE key is SECRET
# (server-side only, never ship it to the app).
SUPABASE_URL=
# The anon/public key signs users in on the app AND lets this backend VERIFY
# their JWTs (verifying a token only calls /auth/v1/user). So real auth works
# with just URL + ANON key — no service key required.
SUPABASE_ANON_KEY=
# The SERVICE ROLE key is only needed to WRITE usage metering (bypasses RLS).
# Optional: without it, auth still works and metering just logs instead.
SUPABASE_SERVICE_KEY=

# --- Server ---
PORT=8080
HOST=0.0.0.0
# Set to "production" on the VPS — the server refuses to boot with
# DEV_SKIP_AUTH=true under NODE_ENV=production (cost-amplification guard).
NODE_ENV=production

# --- Rate limiting ---
# Per-IP / per-Authorization caps applied across /v1/* routes.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Tighter cap on routes that accept unauthenticated requests (bootstrap, screen,
# keyboard/config). Tune up if your SDUI shell needs more headroom.
RATE_LIMIT_UNAUTH_MAX=20

# Set to "true" ONLY for local pipeline testing — every request is mapped to
# a stub user. The server REFUSES to boot if true AND NODE_ENV=production
# (override with DEV_SKIP_AUTH_ALLOW_PROD=true at your own risk).
DEV_SKIP_AUTH=false

# --- Staged rollout (experiments) ---
# Scope any keyboard flag to a slice of users instead of shipping it to 100%.
# JSON array; each rule targets an inclusive bucket range 0-99, so [0,4] = 5%.
# A user's bucket is derived from their id and is STABLE (settings never flip
# mid-session) and SALTED PER FLAG (experiments don't stack on the same
# unlucky users). Malformed rules are dropped with a warning, never thrown.
# Rules here override same-flag rules authored in code (experience/rollout.ts),
# so an experiment can be corrected or killed without waiting for a deploy.
#
#   KB_ROLLOUTS=[{"flag":"kb.touch.holdMultiplier","value":1.4,"buckets":[0,4],"note":"stickier keys, 5%"}]
KB_ROLLOUTS=

# --- Admin ---
# Long random secret authorizing admin HTTP ops (cache bump, media upload).
# Unset → every admin endpoint refuses with 503. Mint: openssl rand -hex 32
ADMIN_SECRET=

# --- Desktop app auth ---
# Comma-separated LONG random secrets accepted as bearer tokens by non-Supabase
# clients (the desktop app). Each maps to a stable synthetic user. Unset → off.
# Mint each with: openssl rand -hex 32
STATIC_BEARER_TOKENS=

# --- Supabase JWT secret (per-user rate limiting) ---
# Dashboard → Settings → API → JWT Secret. Lets the rate limiter verify user
# JWTs LOCALLY and key buckets per-user instead of per-IP. Unset → per-IP
# buckets (users behind one NAT share a bucket and can 429-storm each other).
SUPABASE_JWT_SECRET=

# --- Free-tier quotas (monthly, per user) ---
# 0 / unset = unlimited. Set BOTH to enforce the free tier at launch — this is
# the server-side ceiling that makes the paywall meaningful.
FREE_MONTHLY_AUDIO_SECONDS=0
FREE_MONTHLY_WORDS=0

# Per-request input cap (chars) for prompt-bound text fields.
MAX_TEXT_LENGTH=10000

# Live-STT model for /v1/transcribe-stream (Deepgram).
DEEPGRAM_STT_MODEL=nova-2

# --- Android App Links ---
# SHA-256 fingerprint of the PRODUCTION Play signing key (Play Console →
# Setup → App integrity). Served in /.well-known/assetlinks.json; unset →
# a placeholder is served and Android link verification FAILS.
ANDROID_SIGNING_SHA256=

# --- Error reporting (Sentry) ---
# Without SENTRY_DSN the backend runs with NO error reporting — crashes and
# 5xx bursts in production are invisible. Strongly recommended for launch.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
