# Automatic HTTPS for the Tulmi backend.
#
# The hosts (docs/domain-x0bot.md). x0bot.com and www.x0bot.com are the site,
# on Vercel, which proxies /v1/*, /download, /downloads/*, /privacy, /terms and
# /.well-known/* to the API below. This file is only the VPS's two names, each
# on the new domain AND the old one: the apps already installed have
# tailzu.space built in, so its hosts keep answering here, the same way, with
# no redirect (a POST does not survive one, and Apple refuses an AASA behind one).
#
# 1. DNS A records, all to the VPS (91.108.104.168):
#       api.x0bot.com    api.tailzu.space    (backend API)
#       app.x0bot.com    app.tailzu.space    (app links: /s/*, AASA, assetlinks)
# 2. Deploy with:
#       docker compose --profile https up -d --build
#    and after a change to this file:
#       docker compose --profile https up -d --force-recreate caddy
#
# Caddy fetches and renews Let's Encrypt certificates automatically for every
# hostname listed. A name whose DNS does not point here yet only fails its own
# certificate (Caddy retries); the others are served.
#
# The app hosts proxy to the same backend so
# /.well-known/apple-app-site-association is served from every host Apple
# checks for Universal Links (associatedDomains in the phone's app.config.ts).
# Everything else on them is proxied too: /s/<screenId> is the page a link
# opens in a browser that has no app to hand it to.

# HSTS: these hosts are HTTPS-only, so a browser is told never to try plain
# HTTP first (where a network could answer for us). No includeSubDomains —
# that would bind every future subdomain, including ones hosted elsewhere.
(hsts) {
    header Strict-Transport-Security "max-age=31536000"
}

# COARSE TLS HINTS, FOR ABUSE PREVENTION ONLY (docs/trust.md §request shape). A real phone's TLS looks different from a
# script's. Caddy knows what it negotiated, so it passes three coarse facts to the backend, which uses them for that
# request's own score and NEVER stores them. Each client-sent header of the same name is removed first, so a caller cannot
# claim to be a phone. (A full JA3/JA4 fingerprint would need a third-party Caddy module or Cloudflare Enterprise; we have
# neither, and it is not worth either.)
(tlshints) {
    header_up -X-Tz-Tls-Version
    header_up -X-Tz-Tls-Cipher
    header_up -X-Tz-Tls-Proto
    header_up X-Tz-Tls-Version {http.request.tls.version}
    header_up X-Tz-Tls-Cipher {http.request.tls.cipher_suite}
    header_up X-Tz-Tls-Proto {http.request.proto}
}

api.x0bot.com, api.tailzu.space {
    import hsts
    reverse_proxy backend:8080 {
        import tlshints
    }
}

app.x0bot.com, app.tailzu.space {
    import hsts
    # AASA + assetlinks — always through to the backend, no redirect (Apple
    # rejects Universal Links whose AASA response is a redirect).
    reverse_proxy /.well-known/* backend:8080
    reverse_proxy /apple-app-site-association backend:8080
    # Everything else on the app hosts also goes to the backend, so
    # /s/<screenId>, /privacy and /terms work from the link's own hostname.
    reverse_proxy backend:8080
}
