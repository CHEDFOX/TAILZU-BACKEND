# Keep the Docker build context small + reproducible. The Dockerfile only
# needs tulmi/ and shared/ — everything else is noise (or, for .git/.env*,
# actively harmful in the image).

.git
.gitignore
.gitattributes

# Secrets must never enter the build context.
.env
.env.*
!.env.example
**/.env
**/.env.*

# Docs & top-level READMEs — not needed at runtime.
README.md
DEPLOY.md
docs/

# The Cloudflare jobs Worker (jobs/) is deployed with wrangler, not shipped in the VPS image.
jobs/

# Compose + reverse-proxy configs (used on the host, not inside the image).
docker-compose.yml
deploy/

# Node + TS build artifacts that should be rebuilt cleanly inside the image.
**/node_modules
**/dist
**/.tsbuildinfo
**/*.log

# Editor / OS noise.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test fixtures and one-off scripts the runtime doesn't need.
tulmi/test-assets/
tulmi/scripts/
# Except the two checks DEPLOY.md runs inside the container
# (docker compose exec backend node dist/tulmi/scripts/<name>.js): left out,
# they were never built, and both documented commands answered "Cannot find
# module". They need nothing the server does not already have.
!tulmi/scripts/live-check.ts
!tulmi/scripts/speech-check.ts
# Supabase SQL ships out-of-band via the SQL editor, not in the image.
tulmi/supabase/
# The reality-check harness (recorded runs, bake-offs) runs from a laptop, never in the image. Its bake-off reads
# scripts/eval-prompts.ts, which is left out above, so with it in the context `tsc` failed the image build.
tulmi/e2e/

# Source maps add weight + leak source paths.
**/*.map

# The media worker has its own build context (media-worker/Dockerfile).
media-worker/

# The bots' sounds' masters (scripts/make-bot-sounds.py): the server serves only the .m4a beside them.
shared/bots/sounds/masters/
