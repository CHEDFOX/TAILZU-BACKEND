{
  "name": "tulmi-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Tulmi backend — voice + typing + screen → personalized text (Groq STT, OpenRouter LLM)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/tulmi/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pipeline": "tsx scripts/test-pipeline.ts",
    "smoke": "tsx scripts/smoke.ts",
    "eval": "tsx evals/run.ts",
    "bench": "tsx evals/agent/run.ts",
    "bench:live": "tsx evals/agent/run.ts --mode live --trials 3",
    "bench:record": "tsx evals/agent/run.ts --mode live --record --trials 3",
    "bench:replay": "tsx evals/agent/run.ts --mode replay",
    "bench:scripted": "tsx evals/agent/run.ts --mode scripted",
    "spec": "tsx scripts/spec-dump.ts",
    "bench:stt": "tsx scripts/stt-bench.ts",
    "prompts": "tsx scripts/prompt-dump.ts",
    "prompt-sizes": "tsx scripts/prompt-sizes.ts",
    "gen:queries": "tsx scripts/gen-ts-queries.ts",
    "gen:gitleaks": "tsx scripts/gen-gitleaks.ts",
    "bench:symbols": "tsx evals/symbols/run.ts",
    "bench:locate": "tsx evals/locate/run.ts",
    "bench:secrets": "tsx evals/secrets/run.ts",
    "eval:prompts": "tsx scripts/eval-prompts.ts",
    "e2e": "tsx e2e/run.ts",
    "e2e:repos": "tsx e2e/repos.ts",
    "e2e:mine": "tsx e2e/mine.ts",
    "e2e:author": "tsx e2e/author.ts",
    "e2e:validate": "tsx e2e/validate.ts",
    "e2e:load": "tsx e2e/load.ts",
    "e2e:proxy": "tsx e2e/proxy.ts",
    "e2e:tools": "tsx e2e/agents/tools.ts",
    "e2e:agents": "tsx e2e/agents/prove.ts",
    "e2e:security": "tsx e2e/security/index.ts",
    "bakeoff": "tsx e2e/bakeoff/index.ts",
    "reality": "tsx e2e/reality/index.ts",
    "models-watch": "tsx scripts/models-watch.ts"
  },
  "dependencies": {
    "@deepgram/sdk": "^4.11.3",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@sentry/node": "^8.55.0",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^6.0.0",
    "groq-sdk": "^0.7.0",
    "jose": "^6.2.3",
    "openai": "^4.67.3",
    "tree-sitter-wasm": "2.0.4",
    "undici": "6.23.0",
    "unpdf": "1.9.1",
    "web-tree-sitter": "0.27.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@mozilla/readability": "0.6.0",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "defuddle": "0.19.5",
    "linkedom": "0.18.13",
    "simple-icons": "^16.35.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
