# This file is a slim pointer — the canonical, fully-commented template lives
# at the repo root ../.env.example. Keep them in sync: docker-compose reads
# tulmi/.env via env_file, so during deploy:
#
#   cp ../.env.example tulmi/.env  &&  $EDITOR tulmi/.env
#
# Only the variables actually exported below are picked up by the server; the
# canonical template explains each one in detail.

NODE_ENV=production

STT_PROVIDER=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Live dictation (WS /v1/transcribe-stream) — the KEYBOARD mic's road. The
# in-app mic takes the one-shot road above instead, which is why the two can
# differ in quality on the same sentence.
#
# STT_LIVE_DUAL runs BOTH engines and decides at stop, which is what the
# one-shot road already does. On by default: Deepgram streams the live partials
# because it covers ~100 languages, Sarvam listens silently because it is the
# one that understands Indian and code-mixed speech, and whichever came back in
# a native Indic script leads the final text. Two live streams per dictation.
# Set false to halve that and accept one engine's blind spots.
# STT_LIVE_PROVIDER=openai streams through OpenAI's realtime transcription on
# OPENAI_API_KEY (OPENAI_LIVE_STT_MODEL, gpt-4o-mini-transcribe by default), so
# one key covers both roads. Set STT_LIVE_DUAL=false to hear OpenAI alone.
STT_LIVE_PROVIDER=deepgram
STT_LIVE_DUAL=true
SARVAM_API_KEY=
# Optional — leave blank to disable the Deepgram engine entirely; the app's
# one-shot /v1/transcribe-clean fallback still works.
DEEPGRAM_API_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Leave at false unless you are running test-pipeline.ts locally. The server
# refuses to boot with DEV_SKIP_AUTH=true under NODE_ENV=production.
DEV_SKIP_AUTH=false

# SMS sign-in. Leave false until Twilio Verify is configured in Supabase and a
# real code has arrived on a real phone — with no provider behind it, the phone
# pill in the sign-in gate is a dead end. See TWILIO-SMS.md in the frontend
# repo, including the India/DLT note.
AUTH_ENABLE_PHONE=false

# Flow dictation transport: "stream" (socket, live) or "oneshot" (the app
# buffers the utterance and POSTs it once at stop — retryable, and the same
# fusion path the in-app mic uses). See kb.flow.transport.
FLOW_TRANSPORT=stream

# Hero overrides. Each hero resolves in this order:
#   1. these vars (a raw SDUI node as JSON)
#   2. uploaded media (POST /v1/media/upload?key=onboarding.hero / paywall.1..3)
#   3. the built-in animation
# Leave blank to keep the built-ins. Malformed JSON is logged and ignored — a
# bad paste must not take the app's first screen down with it.
#   HERO_ONBOARDING={"type":"Video","props":{"source":{"key":"onboarding.hero"},"loop":true}}
HERO_ONBOARDING=
HERO_PAYWALL=

# The free tier, in WORDS REFINED per month — the words Tailzu writes for you,
# which is what the product does and what costs money to produce. Not minutes
# spoken: someone who dictates slowly is not costing more than someone who
# dictates fast. 0 = unlimited.
#
# The app reads the same number (bootstrap flag quota.freeMonthlyWords) to show
# progress and to decide when to show the paywall, so it can never disagree
# with what the server enforces.
# 800, matching config.ts's default — so a project running with the variable
# unset and one running from this file agree. They did not: this said 2500 and
# the default said 800, and since the docs tell you to copy this file, the
# number a real deployment enforced depended on whether anyone had bothered.
FREE_MONTHLY_WORDS=800
# Left at 0 deliberately: one meter is legible, two is a thing users have to
# reason about.
FREE_MONTHLY_AUDIO_SECONDS=0
# Questions spoken to Ask, in seconds a month. Their words are never written,
# so they do not spend FREE_MONTHLY_WORDS; this is their own ceiling, so a
# stream that calls itself a question is not free transcription. 0 = none.
# FREE_MONTHLY_AGENT_AUDIO_SECONDS=1800
# Questions about a picture (Ask's vision calls) a free account may ask in a
# day. They are metered as no words and no seconds. 0 = none.
# FREE_DAILY_AGENT_PICTURES=100

# When the post-splash intro plays: firstRun (default) | everyLaunch | never.
# It only plays at all once a file is uploaded:
#   curl -X POST "$BASE/v1/media/upload?key=intro" -H "Authorization: Bearer $ADMIN" -F file=@intro.mp4
# firstRun means "until they finish onboarding" — a returning user opening the
# app to write something does not want to sit through it.
INTRO_PLAY_WHEN=firstRun

# How hard the writing model thinks before answering.
#
# CLEANUP_MODEL defaults to a GPT-5-class model, and those REASON before they
# answer. Nothing used to pass this, so every refine ran at the provider's
# default effort — spending tokens deliberating before emitting a single word.
# Rewriting a sentence someone just said is not a problem that needs thinking
# through, so: none.
#
# Raise it (minimal | low | medium | high) if a harder task justifies the wait,
# and settle whether it does with `npm run eval` rather than by feel.
# "default" leaves the parameter off entirely.
LLM_REASONING_EFFORT=none

# The writing model itself. Swap without a code change.
# CLEANUP_MODEL=openai/gpt-5.4-mini

# The writer names what they mean in one line (<intent>) before it writes the
# message (<send>), and only the message reaches the field. It is the thinking
# a reasoning model would do, for one line of output instead of a wait.
# "false" goes back to the plain answer, to compare the two with
# scripts/quality.sh --compare.
# WRITER_INTENT_STEP=true

# Ask, the on-screen agent (POST /v1/agent). It plans one step at a time while
# someone watches the guide wait for its first line, so the model is a fast one
# with reasoning off. The fallbacks are tried in order, then CLEANUP_MODEL, and
# only when a call fails before it has written anything.
# AGENT_MODEL=openai/gpt-6-luna
# AGENT_FALLBACK_MODELS=anthropic/claude-haiku-5.5
# AGENT_TIMEOUT_MS=6000
# AGENT_MAX_STEPS=8
# AGENT_MAX_ELEMENTS=250
# AGENT_SCREEN_MAX_CHARS=24000
# A question about something drawn (an equation, a chart, a diagram) comes with
# one picture of it and goes to a model that can see, by the same ladder rules,
# each model once. Chosen on speed, measured on the VPS with one picture
# question (scripts/time-vision.ts measures it again): Gemini 2.5 Flash reached
# its first sentence in 2.1 s, 2.4 s at worst, with latency routing, about
# twice as fast as Haiku 5.5 (4.6 s, 6.1 s at worst); Gemini 3.8 Flash reads
# pictures better but took 4.2 s, and 15 s at worst. "Step by step", "in
# detail" and "walk me through" go to the deep model, the same one given room
# for a longer answer, never a slower one. The timeout is to the first written
# character and between chunks, so a long worked answer is not cut off mid-step.
# AGENT_VISION_MODEL=google/gemini-2.5-flash
# AGENT_VISION_FALLBACK_MODELS=anthropic/claude-haiku-5.5
# AGENT_VISION_DEEP_MODEL=google/gemini-2.5-flash
# AGENT_VISION_TIMEOUT_MS=9000
# Picture questions ask OpenRouter for the provider of each model that answers
# soonest: it took Gemini 2.5 Flash's worst first sentence from 4.6 s to 2.4 s.
# "throughput" and "price" are OpenRouter's other two sorts; empty sends no
# preference, and OpenRouter balances the load its own way.
# AGENT_VISION_PROVIDER_SORT=latency
# The one picture a step may carry, in bytes; above it is a 413.
# AGENT_IMAGE_MAX_BYTES=2000000
# Marks one step may draw on the screen while it explains (DRAW lines); the
# rest are dropped. 0 turns drawing off.
# AGENT_DRAW_MAX=12
# Its own rate limit, so a run of Ask steps is never why dictation gets a 429.
# AGENT_RATE_LIMIT_MAX=60
# AGENT_RATE_LIMIT_WINDOW_MS=60000
# A question spoken on the live stream, in seconds: the desktop listens for
# 15 at most, and past this the stream ends with what it heard.
# AGENT_STREAM_MAX_SECONDS=30

# NO "$" IN ANY SECRET ON THIS PAGE. Docker Compose interpolates $NAME inside
# env_file values, so a secret containing one reaches the process with that
# chunk replaced — usually by nothing. The service starts, everything looks
# fine, and the only thing that breaks is the sender getting 401: a customer is
# charged and never granted anything. The one sign is a line at startup:
#   WARN The "..." variable is not set. Defaulting to a blank string.

# ── Paying on the desktop ────────────────────────────────────────────────────
# A RevenueCat web purchase link, and the ONLY thing needed to turn on
# subscriptions in the desktop app.
#
# RevenueCat has no desktop SDK, so the window cannot buy the way the phones
# do — it drew the paywall with every row on it dead. A web purchase link fits
# here for free because the identity already lines up: the phones configure
# RevenueCat with the Supabase user id as the app user id, the webhook resolves
# that same id back, and a web purchase for that id lands on the same customer
# and writes the same entitlements row. The webhook needs no change at all.
#
# So someone who paid on a phone is already entitled in the window, and someone
# who pays in the window is entitled on their phone.
#
# WHICH BILLING ENGINE IS BEHIND THE LINK IS A DASHBOARD CHOICE. RevenueCat
# backs these with its own billing, with Stripe, or with Paddle, and nothing on
# this side can tell which: the webhook is the same webhook and `store` is
# recorded rather than branched on. Paddle is worth knowing about because it is
# the MERCHANT OF RECORD — it registers, collects and remits sales tax
# worldwide, which Stripe does not. Moving to it later is a new link here.
#
# WHERE THE USER ID GOES IS PART OF THE LINK, because the shapes differ and
# guessing wrong is the failure that looks like success — the card is charged
# and the webhook arrives with no id to attach it to. Put {app_user_id} where
# your link wants it; with no placeholder the desktop appends ?app_user_id=…,
# which is what a Web Purchase Link expects.
#
# This is a PUBLIC link — it is opened in the user's browser. It is not a
# credential and it is not the secret key. Unset means no purchase path on the
# desktop, and the app is told so rather than drawing buttons that do nothing.
#
# Sent ONLY to a desktop client. An external purchase link in an iOS build is
# the anti-steering rule Apple rejects for.
# REVENUECAT_WEB_PAYWALL_URL=https://pay.rev.cat/xxxxxxxxxxxx/{app_user_id}
#
# Or Tailzu's own pay page (GET /pay, served as tailzu.space/pay), which opens
# Razorpay's checkout for a subscription the server creates for the account:
# REVENUECAT_WEB_PAYWALL_URL=https://tailzu.space/pay
# Razorpay. Test keys (rzp_test_) first. The key id and plan ids are public;
# the key secret and webhook secret are not, and live only here. Webhook URL
# for the Razorpay dashboard: https://api.tailzu.space/v1/billing/razorpay
# (all subscription.* events). RAZORPAY_PLANS is the line
# tulmi/scripts/razorpay-plans.mjs prints after creating the plans.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLANS=IN:monthly:plan_...,IN:annual:plan_...,world:monthly:plan_...,world:annual:plan_...
# To prove a live payment while FREE_FOR_ALL is on, no setting is needed:
# ./tulmi/scripts/paylink.sh you@example.com prints a one-day test link.

# --- Connected apps (Ask acting in Notion, Linear, Jira...). Off by default. ---
# Setup and the per-app endpoint check are in ../DEPLOY.md ("Connected apps").
# CONNECTORS=false
# CONNECTORS_ENABLED_IDS=notion,linear
# openssl rand -base64 32  (encrypts stored tokens; changing it disconnects everyone)
# CONNECTOR_TOKEN_KEY=
# CONNECTOR_REDIRECT_URL=https://api.tailzu.space/v1/connectors/callback
# Tailzu's published client identity (CIMD), served by this server at
# /oauth/client-metadata.json and listing CONNECTOR_REDIRECT_URL. Apps whose auth
# server supports it sign in with it instead of registering a new client each time.
# A staging server sets its own host here, or "" to turn it off.
# CONNECTOR_CLIENT_METADATA_URL=https://api.tailzu.space/oauth/client-metadata.json
# OAuth clients registered with a vendor in advance (GitHub and Asana offer no
# other way in; Jira and Confluence use the document above). One line of JSON,
# by catalog id; the issuer is the vendor's auth server. Secrets live here only.
# Bad JSON is ignored.
# CONNECTOR_OAUTH_CLIENTS={"github":{"client_id":"","client_secret":"","issuer":"https://github.com/login/oauth"}}
# Apps people add themselves by pasting an MCP server's address (needs migration
# 0018 and CONNECTORS=true). Off by default; at most CUSTOM_CONNECTORS_MAX each.
# While on, the server also copies the official MCP Registry into mcp_directory
# every 12 hours for the More apps search (outbound https to
# registry.modelcontextprotocol.io).
# CUSTOM_CONNECTORS=false
# CUSTOM_CONNECTORS_MAX=10
# Google Calendar and Google Docs (ids google-calendar, google-docs in CONNECTORS_ENABLED_IDS):
# the WEB OAuth client of the Google Cloud project the Google sign-in already uses.
# It must list CONNECTOR_REDIRECT_URL above as an authorized redirect URI.
# GOOGLE_CONNECT_CLIENT_ID=
# GOOGLE_CONNECT_CLIENT_SECRET=
