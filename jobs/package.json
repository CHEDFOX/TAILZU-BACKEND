{
  "name": "tailzu-jobs",
  "version": "0.1.0",
  "private": true,
  "description": "Tailzu Code bot jobs on Cloudflare: Workflows + Cron for the agent loop and the project brain. The shared logic is imported from ../tulmi/src.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "5.20261026.1",
    "@types/node": "20.19.41",
    "tree-sitter-wasm": "2.0.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "web-tree-sitter": "0.27.1",
    "wrangler": "4.153.0"
  }
}
