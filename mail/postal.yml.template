# Postal's configuration. setup.sh fills the ${...} values from .env and writes
# /opt/postal/config/postal.yml. Edit that file for a live change, then
# `docker compose restart`; edit this one for the change to survive a re-setup.
version: 2

postal:
  web_hostname: postal.${MAIL_DOMAIN}
  smtp_hostname: smtp.${MAIL_DOMAIN}
  # Signs every outgoing message (DKIM) and the return-path; made by setup.sh.
  signing_key_path: /config/signing.key
  # A message that bounces this many times is given up on.
  default_maximum_delivery_attempts: 18
  default_maximum_hold_expiry_days: 7
  # An address that hard-bounced stays suppressed this long.
  default_suppression_list_automatic_removal_days: 30
  # The receivers' spam checks are the ones that matter; Postal's own scoring
  # is off until rspamd is added.
  default_spam_threshold: 5
  default_spam_failure_threshold: 20

web_server:
  default_port: 5000
  default_bind_address: 0.0.0.0
  max_threads: 5

worker:
  threads: 4

smtp_server:
  default_port: 25
  default_bind_address: 0.0.0.0
  # STARTTLS on the submission ports. The certificate is certbot's for
  # smtp.${MAIL_DOMAIN}, copied in by certbot-hook.sh.
  tls_enabled: true
  tls_certificate_path: /config/tls/fullchain.pem
  tls_private_key_path: /config/tls/privkey.pem
  log_connections: false
  max_message_size: 14

main_db:
  host: mariadb
  port: 3306
  username: postal
  password: ${DB_PASSWORD}
  database: postal
  pool_size: 10

message_db:
  host: mariadb
  port: 3306
  username: postal
  password: ${DB_PASSWORD}
  prefix: postal

dns:
  # Where bounces come back to, and the SPF every sending domain includes.
  mx_records:
    - mx.${MAIL_DOMAIN}
  spf_include: spf.${MAIL_DOMAIN}
  return_path_domain: rp.${MAIL_DOMAIN}
  route_domain: routes.${MAIL_DOMAIN}
  track_domain: track.${MAIL_DOMAIN}
  helo_hostname: smtp.${MAIL_DOMAIN}
  dkim_identifier: postal
  domain_verify_prefix: postal-verification
  custom_return_path_prefix: psrp

# Postal's own notices (a held-message digest, a password reset), sent through
# its own SMTP server.
smtp:
  host: smtp
  port: 25
  from_name: Postal
  from_address: ${SYSTEM_FROM}

rails:
  environment: production
  secret_key: ${RAILS_SECRET}

logging:
  rails_log_enabled: false
  highlighting_enabled: false
