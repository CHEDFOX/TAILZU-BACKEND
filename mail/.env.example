# The mail platform's own values. Copy to .env; .env is never committed.

# The platform domain: the dashboard is postal.<this>, apps connect to
# smtp.<this>, bounces come back to rp.<this>. A company domain, not an app's.
MAIL_DOMAIN=mail.xooteqlab.com

# The VPS's public IPv4, as in the SPF record and the PTR.
VPS_IP=91.108.104.168

# MariaDB. Any long random strings; setup.sh uses them once to create the users.
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-postal

# The first dashboard login (setup.sh asks for the password).
ADMIN_EMAIL=you@xooteqlab.com
ADMIN_NAME=Owner

# Where Postal's own notices (a bounce digest, a password reset) come from.
SYSTEM_FROM=postal@mail.xooteqlab.com

# Pinned image; move it deliberately.
POSTAL_IMAGE=ghcr.io/postalserver/postal:3.3.4
