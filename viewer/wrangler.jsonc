{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tailzu-viewer",
  "main": "src/index.ts",

  // The newest date the pinned wrangler's runtime (workerd 1.20261023.1) runs.
  "compatibility_date": "2026-10-23",

  // The viewer must live on its OWN site, never the app's (docs/artifact-viewer.md). *.workers.dev is on the Public Suffix List, so
  // tailzu-viewer.<your-subdomain>.workers.dev is a different site from tailzu.space until a domain of its own is chosen.
  "workers_dev": true,
  "observability": { "enabled": true },

  // Runs before `wrangler dev` and `wrangler deploy`: vendors the libraries (when public/vendor is not there yet) and builds the runtime
  // and the shell page into public/. See scripts/build.mjs and scripts/vendor.mjs.
  "build": { "command": "node scripts/build.mjs", "watch_dir": ["web", "lib", "scripts"] },

  // Workers Static Assets. https://developers.cloudflare.com/workers/static-assets/binding/
  //   - The runtime and the vendored libraries have hashed names and are served by the platform with the headers in public/_headers
  //     (immutable cache, CORS for the sandboxed iframe's opaque origin). They never run this Worker: no invocation, no CPU.
  //   - run_worker_first lists the only paths the Worker handles: the shell page (its CSP depends on configuration), the test host
  //     (off in production) and the shell's template (hidden). Everything else is a plain asset.
  //   - html_handling "none": no redirects or rewrites of paths that look like pages.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/__host", "/shell.html"]
  },

  // Plain settings, no secrets: the viewer holds none.
  "vars": {
    // "production" turns the /__host test page off. For local work: `wrangler dev --var ENV:development`.
    "ENV": "production",
    // Who may embed the viewer (CSP frame-ancestors) and talk to it (postMessage origin check). Comma-separated; https://*.preview.example
    // allows every subdomain. Set it to where the app is served.
    "VIEWER_PARENT_ORIGINS": "https://tailzu.space,https://www.tailzu.space"
  }
}
