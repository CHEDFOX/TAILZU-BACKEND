# Everything the viewer serves except the shell page (that one is made by the Worker, with the CSP).
#
# The runtime and the vendored libraries have the hash of their content in the file name, so a URL never changes meaning: cache it for ever.
# The page that loads them runs in a sandboxed iframe with an opaque origin, so every module and font request is cross-origin: CORS must allow it.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  X-Content-Type-Options: nosniff

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  X-Content-Type-Options: nosniff

# The list of hashes of the vendored files is the one file in /vendor/ whose name does not carry a hash: it is read by people, not by the
# page, and it changes when a library is bumped.
/vendor/integrity.json
  ! Cache-Control
  Cache-Control: public, max-age=300
